# Local dev: point at your local Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fit4830

# Production (DigitalOcean Managed Postgres) requires sslmode=require
# DATABASE_URL=postgres://user:pass@host:25060/db?sslmode=require

# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Used to build invite links
NEXT_PUBLIC_APP_URL=http://localhost:3000
